{
  "name": "aftershock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "aftershock": "tsx packages/cli/src/index.ts",
    "test:fixtures": "tsx --test tests/fixture-capabilities.integration.ts",
    "test:ttl": "tsx --test tests/ttl.integration.ts",
    "test:integration": "tsx --test tests/local.integration.ts",
    "test:mining": "tsx --test tests/mining.integration.ts",
    "test:replay:mining": "tsx --test tests/replay-mining.integration.ts",
    "test:replay": "tsx --test tests/replay.integration.ts",
    "test:lifecycle": "tsx --test tests/lifecycle.integration.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/evidence.test.ts tests/evidence-check.test.ts tests/rpc.test.ts tests/cli.test.ts tests/scenario.test.ts tests/mining.test.ts && node --test tests/probe-devnet.test.mjs",
    "lint": "oxlint --deny-warnings packages tests scripts",
    "format": "prettier --write packages tests/*.ts package.json tsconfig.json .oxlintrc.json .prettierrc.json",
    "format:check": "prettier --check packages tests/*.ts package.json tsconfig.json .oxlintrc.json .prettierrc.json"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
