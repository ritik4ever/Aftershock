# Optional local source root for the staked-storage demo only.
# Contains the dedicated workshop/ and sidecar/ Git repositories.
# Export this variable in your shell; the app does not auto-load .env files.
# Without it, the default is ../aftershock-upstream beside the Linux checkout.
AFTERSHOCK_UPSTREAM_ROOT=/path/to/aftershock-upstream

# Optional GitHub Actions execution. Configure these only in Vercel server settings.
# Fine-grained token: Aftershock repository only, Actions read/write permission.
# Placeholders only. Never commit actual values or expose the token in browser code.
AFTERSHOCK_GITHUB_TOKEN=replace-with-a-repository-scoped-token
AFTERSHOCK_RUNNER_ACCESS_CODE=replace-with-a-separate-random-demo-access-code
